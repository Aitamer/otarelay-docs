            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/channel/room-type-rate-plan-associations?hotel_id={{hotel_id}}",
              "host": ["{{base_url}}"],
              "path": ["channel", "room-type-rate-plan-associations"],
              "query": [{ "key": "hotel_id", "value": "{{hotel_id}}" }]
            }
