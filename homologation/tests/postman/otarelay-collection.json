          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('retourne le hotel_id demandé', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.hotel_id).to.eql(pm.collectionVariables.get('hotel_id'));",
                  "});",
                  "pm.test('retourne associations[] et summary', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.associations).to.be.an('array');",
                  "    pm.expect(body.summary).to.have.property('total');",
                  "    pm.expect(body.summary).to.have.property('mapped');",
                  "    pm.expect(body.summary).to.have.property('unmapped');",
                  "});"
                ]
