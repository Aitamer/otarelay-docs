meta {
  name: Push restrictions valides → 200
  type: http
  seq: 1
}

post {
  url: {{base_url}}/channel/restrictions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{api_key}}
  Content-Type: application/json
}

body:json {
  {
    "hotel_id": "{{hotel_id}}",
    "rate_plan_room_id": {{rate_plan_room_id_push}},
    "date": "{{restriction_date_base}}",
    "min_stay": 2,
    "max_stay": 14
  }
}

assert {
  res.status: eq 200
}

tests {
  test("status ok, processed == 1 et failed == 0", function() {
    const body = res.getBody();
    expect(body.status).to.equal('ok');
    expect(body.processed).to.equal(1);
    expect(body.failed).to.equal(0);
  });
}

script:pre-request {
  const d = new Date();
  d.setUTCDate(d.getUTCDate() + 200);
  bru.setVar('restriction_date_base', d.toISOString().slice(0, 10));

  // Voir phase5-availability/01-push-single.bru pour l'explication de cette pré-confirmation
  // (idempotente) du mapping avant le push.
  const mappingRes = await fetch(`${bru.getEnvVar('base_url')}/channel/association-mapping`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${bru.getEnvVar('api_key')}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      hotel_id: bru.getEnvVar('hotel_id'),
      rate_plan_room_id: Number(bru.getVar('rate_plan_room_id_push')),
    }),
  });
  if (!mappingRes.ok) {
    console.warn('Pré-confirmation du mapping échouée (status ' + mappingRes.status + ').');
  }
}
